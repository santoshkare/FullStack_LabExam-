<div class="container">
  <div style="max-width: 700px; margin: 0 auto;">
    <div style="margin-bottom: 2.5rem;">
      <h1 style="margin-bottom: 0.5rem;">Create New Course</h1>
      <p style="color: #718096; font-size: 1rem;">Add a new course to your platform</p>
    </div>

    <div class="card">
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="error" style="margin-bottom: 2rem;">
          ⚠️ <%= error %>
        </div>
      <% } %>

      <form action="/courses" method="POST">
        <div style="margin-bottom: 2rem;">
          <label for="courseName" style="font-weight: 600; color: #2d3748; margin-bottom: 0.7rem; display: block;">Course Name</label>
          <input type="text" id="courseName" name="courseName" required placeholder="e.g., Advanced Web Development" style="width: 100%; padding: 0.95rem 1.2rem; border: 2px solid #e2e8f0; border-radius: 8px; font-size: 1rem; background: #f7fafc;">
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 2rem;">
          <div>
            <label for="price" style="font-weight: 600; color: #2d3748; margin-bottom: 0.7rem; display: block;">Price ($)</label>
            <input type="number" id="price" name="price" required min="0" step="0.01" placeholder="99.99" style="width: 100%; padding: 0.95rem 1.2rem; border: 2px solid #e2e8f0; border-radius: 8px; font-size: 1rem; background: #f7fafc;">
          </div>

          <div>
            <label for="duration" style="font-weight: 600; color: #2d3748; margin-bottom: 0.7rem; display: block;">Duration (weeks)</label>
            <input type="number" id="duration" name="duration" required min="1" placeholder="8" style="width: 100%; padding: 0.95rem 1.2rem; border: 2px solid #e2e8f0; border-radius: 8px; font-size: 1rem; background: #f7fafc;">
          </div>
        </div>

        <div style="margin-bottom: 2rem;">
          <label for="image" style="font-weight: 600; color: #2d3748; margin-bottom: 0.7rem; display: block;">Image URL</label>
          <input type="url" id="image" name="image" required placeholder="https://example.com/image.jpg" style="width: 100%; padding: 0.95rem 1.2rem; border: 2px solid #e2e8f0; border-radius: 8px; font-size: 1rem; background: #f7fafc;">
          <small style="color: #718096; margin-top: 0.5rem; display: block;">Use a valid image URL (HTTPS recommended)</small>
        </div>

        <div style="margin-bottom: 2rem;">
          <label for="courseStartDate" style="font-weight: 600; color: #2d3748; margin-bottom: 0.7rem; display: block;">Start Date</label>
          <input type="date" id="courseStartDate" name="courseStartDate" required style="width: 100%; padding: 0.95rem 1.2rem; border: 2px solid #e2e8f0; border-radius: 8px; font-size: 1rem; background: #f7fafc;">
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 2.5rem;">
          <button type="submit" class="btn btn-success" style="padding: 1rem; font-size: 1rem; font-weight: 600; border: none; cursor: pointer;">
            ✅ Create Course
          </button>
          <a href="/courses" class="btn btn-secondary" style="padding: 1rem; font-size: 1rem; font-weight: 600; text-align: center; text-decoration: none; cursor: pointer;">
            ❌ Cancel
          </a>
        </div>
      </form>
    </div>
  </div>
</div>
