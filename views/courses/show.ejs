<div class="container">
  <a href="/courses" style="color: #667eea; text-decoration: none; font-weight: 600; margin-bottom: 2rem; display: inline-block;">
    ← Back to Courses
  </a>

  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; margin-top: 2rem;">
    <div>
      <div style="border-radius: 12px; overflow: hidden; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);">
        <img src="<%= course.image %>" alt="<%= course.courseName %>" style="width: 100%; height: 400px; object-fit: cover;">
      </div>
    </div>

    <div class="card">
      <h1 style="font-size: 2.2rem; margin-bottom: 1.5rem;"><%= course.courseName %></h1>

      <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 1.5rem; border-radius: 8px; margin-bottom: 2rem;">
        <p style="font-size: 0.9rem; opacity: 0.9; margin-bottom: 0.5rem;">COURSE PRICE</p>
        <p style="font-size: 3rem; font-weight: 700;">$<%= course.price %></p>
      </div>

      <div style="background: #f7fafc; padding: 1.5rem; border-radius: 8px; margin-bottom: 2rem;">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
          <div>
            <p style="color: #718096; font-size: 0.9rem; margin-bottom: 0.5rem;">📚 Duration</p>
            <p style="font-size: 1.5rem; font-weight: 700; color: #2d3748;"><%= course.duration %> Weeks</p>
          </div>

          <div>
            <p style="color: #718096; font-size: 0.9rem; margin-bottom: 0.5rem;">📅 Start Date</p>
            <p style="font-size: 1.3rem; font-weight: 700; color: #2d3748;"><%= new Date(course.courseStartDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></p>
          </div>
        </div>
      </div>

      <div style="background: #f0f4ff; padding: 1.5rem; border-radius: 8px; margin-bottom: 2rem; border-left: 5px solid #667eea;">
        <p style="color: #4c5f93; font-size: 0.9rem; margin-bottom: 0.5rem;">📝 Created</p>
        <p style="color: #2d3748; font-weight: 600;"><%= new Date(course.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 2.5rem;">
        <a href="/courses/<%= course._id %>/edit" class="btn btn-success" style="text-align: center; padding: 1rem; font-weight: 600;">
          ✏️ Edit Course
        </a>
        <a href="/courses/<%= course._id %>/delete" class="btn btn-danger" style="text-align: center; padding: 1rem; font-weight: 600;" onclick="return confirm('Are you sure you want to delete this course?')">
          🗑️ Delete
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  @media (max-width: 768px) {
    .container {
      grid-template-columns: 1fr !important;
    }
  }
</style>
