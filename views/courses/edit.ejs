<div class="container">
  <div style="max-width: 700px; margin: 0 auto;">
    <div style="margin-bottom: 2.5rem;">
      <h1 style="margin-bottom: 0.5rem;">Edit Course</h1>
      <p style="color: #718096; font-size: 1rem;">Update course details</p>
    </div>

    <div class="card">
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="error" style="margin-bottom: 2rem;">
          ⚠️ <%= error %>
        </div>
      <% } %>

      <div style="background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%); padding: 1.2rem; border-radius: 8px; margin-bottom: 2rem; border-left: 5px solid #f59e0b;">
        <p style="color: #92400e; font-weight: 500; margin: 0;">
          ℹ️ <strong>Note:</strong> Course name cannot be changed after creation.
        </p>
      </div>

      <form action="/courses/<%= course._id %>" method="POST">
        <div style="margin-bottom: 2rem;">
          <label for="courseName" style="font-weight: 600; color: #2d3748; margin-bottom: 0.7rem; display: block;">Course Name</label>
          <input type="text" id="courseName" name="courseName" value="<%= course.courseName %>" disabled style="width: 100%; padding: 0.95rem 1.2rem; border: 2px solid #e2e8f0; border-radius: 8px; font-size: 1rem; background: #edf2f7; cursor: not-allowed; opacity: 0.7;">
          <small style="color: #718096; margin-top: 0.5rem; display: block;">This field is locked and cannot be changed</small>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 2rem;">
          <div>
            <label for="price" style="font-weight: 600; color: #2d3748; margin-bottom: 0.7rem; display: block;">Price ($)</label>
            <input type="number" id="price" name="price" value="<%= course.price %>" required min="0" step="0.01" style="width: 100%; padding: 0.95rem 1.2rem; border: 2px solid #e2e8f0; border-radius: 8px; font-size: 1rem; background: #f7fafc;">
          </div>

          <div>
            <label for="duration" style="font-weight: 600; color: #2d3748; margin-bottom: 0.7rem; display: block;">Duration (weeks)</label>
            <input type="number" id="duration" name="duration" value="<%= course.duration %>" required min="1" style="width: 100%; padding: 0.95rem 1.2rem; border: 2px solid #e2e8f0; border-radius: 8px; font-size: 1rem; background: #f7fafc;">
          </div>
        </div>

        <div style="margin-bottom: 2rem;">
          <label for="image" style="font-weight: 600; color: #2d3748; margin-bottom: 0.7rem; display: block;">Image URL</label>
          <input type="url" id="image" name="image" value="<%= course.image %>" required style="width: 100%; padding: 0.95rem 1.2rem; border: 2px solid #e2e8f0; border-radius: 8px; font-size: 1rem; background: #f7fafc;">
        </div>

        <div style="margin-bottom: 2rem;">
          <label for="courseStartDate" style="font-weight: 600; color: #2d3748; margin-bottom: 0.7rem; display: block;">Start Date</label>
          <input type="date" id="courseStartDate" name="courseStartDate" value="<%= course.courseStartDate.toISOString().split('T')[0] %>" required style="width: 100%; padding: 0.95rem 1.2rem; border: 2px solid #e2e8f0; border-radius: 8px; font-size: 1rem; background: #f7fafc;">
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 2.5rem;">
          <button type="submit" class="btn btn-success" style="padding: 1rem; font-size: 1rem; font-weight: 600; border: none; cursor: pointer;">
            ✅ Save Changes
          </button>
          <a href="/courses/<%= course._id %>" class="btn btn-secondary" style="padding: 1rem; font-size: 1rem; font-weight: 600; text-align: center; text-decoration: none; cursor: pointer;">
            ❌ Cancel
          </a>
        </div>
      </form>
    </div>
  </div>
</div>
